<section class="page-th" aria-labelledby="page-titre">
  <div class="page-th-contenu">
    <p class="surtitre">{{ surtitre }}</p><h1 id="page-titre">{{ title }}</h1>{% if intro %}<p class="chapo">{{ intro }}</p>{% endif %}
  </div>
  {% if bandeau_image %}<img class="page-th-image" src="{{ bandeau_image }}" alt="{{ bandeau_alt }}" width="1600" height="900" fetchpriority="high">{% endif %}
</section>
