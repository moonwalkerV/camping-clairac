<section class="section faq"><div class="conteneur">
  {% include "sections/_entete-section.njk" %}
  <div class="faq-liste">{% for i in s.items %}<details><summary>{{ i.titre }}</summary><p>{{ i.texte }}</p></details>{% endfor %}</div>
</div></section>
{%- if s.items and s.items.length %}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for i in s.items %}{"@type":"Question","name":{{ i.titre | dump | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ i.texte | dump | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}</script>
{%- endif %}
