{% set en = (lang == "en") %}<article class="lieu lieu-long">
    {% if p.image %}<img src="{{ p.image | replace('/images/', '/assets/img/photos/') }}" alt="{{ p.alt }}" width="800" height="600" loading="lazy">{% endif %}
    <div class="lieu-texte"><h3>{{ p.name }}</h3>{% if p.subtitle %}<p class="lieu-sous">{{ p.subtitle }}</p>{% endif %}
    <p>{{ p.text }}</p>
    {% if p.hours %}<p class="petit"><strong>{{ "Opening times:" if en else "Horaires :" }}</strong> {{ p.hours }}</p>{% endif %}
    {% if p.note %}<p class="petit">{{ p.note }}</p>{% endif %}
    <p class="lieu-liens">{% if p.mapsQuery %}<a href="https://www.google.com/maps/search/?api=1&amp;query={{ p.mapsQuery | urlencode }}" rel="noopener">{{ "View on map" if en else "Voir sur la carte" }}<span class="cache-visuel"> : {{ p.name }}</span></a>{% endif %}{% if p.website %} <a href="{{ p.website }}" rel="noopener">{{ "Website" if en else "Site web" }}<span class="cache-visuel">{{ " of " if en else " de " }}{{ p.name }}</span></a>{% endif %}</p>
    {% if p.credit %}<p class="credit">{{ "Photo: " if en else "Photo : " }}{{ p.credit }}</p>{% endif %}</div>
  </article>