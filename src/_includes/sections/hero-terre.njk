<section class="th" aria-labelledby="th-titre">
  <picture><source media="(max-width:700px)" srcset="{{ s.image_petite }}"><img class="th-image" src="{{ s.image }}" alt="{{ s.alt }}" width="1600" height="899" fetchpriority="high"></picture>
  <div class="th-voile" aria-hidden="true"></div>
  <div class="th-contenu">
    <p class="th-surtitre">{{ s.surtitre }}</p>
    <h1 id="th-titre">{{ s.accroche }}</h1>
    <div class="th-actions"><a class="bouton" href="{{ site.bouton_flottant.lien }}">{{ s.b1 or "Demander une réservation" }}</a><a class="th-lien" href="#sejours">{{ s.b2 or "Découvrir les séjours" }}</a></div>
    <p class="meteo-court" data-meteo="court" aria-live="polite" aria-busy="true"></p>
  </div>
  <a class="th-bas" href="#ambiance">{{ "Discover Clairac" if lang == "en" else "Découvrir Clairac" }} <span aria-hidden="true">↓</span></a>
</section>
<section class="ambiance" id="ambiance" aria-label="L'esprit de Clairac">
  <p class="amb-phrase">{% for m in s.ambiance.split(" ") %}<span class="mot">{{ m }}</span> {% endfor %}</p>
  <div class="amb-photos">
    <figure class="amb-p amb-a"><img src="/assets/img/photos/olivier-pique-nique-sanitaires.webp" alt="Une table de pique-nique sous un olivier" width="1200" height="900" loading="lazy"></figure>
    <figure class="amb-p amb-b"><img src="/assets/img/photos/vignes-domaine-batisse.webp" alt="Les vignes du domaine devant la bâtisse ancienne" width="1200" height="900" loading="lazy"></figure>
    <figure class="amb-p amb-c"><img src="/assets/img/photos/camping-nature-lauriers-roses.webp" alt="Des lauriers roses en fleurs sous les grands pins" width="1200" height="900" loading="lazy"></figure>
  </div>
</section>
