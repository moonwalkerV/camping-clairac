{% set en = (lang == "en") %}<section class="th" aria-labelledby="th-titre">
  <picture><source media="(max-width:700px)" srcset="{{ s.image_petite }}"><img class="th-image" src="{{ s.image }}" alt="{{ s.alt }}" width="1600" height="899" fetchpriority="high"></picture>
  <div class="th-voile" aria-hidden="true"></div>
  <div class="th-contenu">
    <h1 id="th-titre">{{ s.accroche }}</h1>
    <div class="th-actions"><a class="bouton" href="{{ site.en.bouton_flottant.lien if en else site.bouton_flottant.lien }}">{{ s.b1 or "Demander une réservation" }}</a></div>
  </div>
</section>
<section class="ambiance" id="ambiance" aria-label="{{ 'The spirit of Clairac' if en else 'L\'esprit de Clairac' }}">
  <div class="amb-tete">
    <p class="amb-phrase">{% for m in s.ambiance.split(" ") %}<span class="mot">{{ m }}</span> {% endfor %}</p>
    <ul class="amb-mentions">{% for m in s.mentions %}<li>{{ m }}</li>{% endfor %}</ul>
  </div>
  <div class="amb-photos">
    <figure class="amb-p amb-a"><img src="/assets/img/photos/prairie-pins-harmonisee.webp" alt="{{ 'A meadow shaded by the estate\'s pines' if en else 'Une prairie ombragée par les pins du domaine' }}" width="1200" height="900" loading="lazy"></figure>
    <figure class="amb-p amb-b"><img src="/assets/img/photos/vignes-domaine.webp" alt="{{ 'A vine of the estate, heavy with leaves and grapes' if en else 'Un pied de vigne du domaine, chargé de feuilles et de raisins' }}" width="1200" height="900" loading="lazy"></figure>
    <figure class="amb-p amb-c"><img src="/assets/img/photos/camping-emplacements-oliviers.webp" alt="{{ 'Pitches among the olive trees' if en else 'Des emplacements parmi les oliviers' }}" width="1200" height="900" loading="lazy"></figure>
  </div>
</section>
