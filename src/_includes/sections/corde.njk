{% set en = (lang == "en") %}<section class="corde" aria-labelledby="corde-titre"><div class="conteneur"><p class="surtitre">{{ s.surtitre }}</p><h2 id="corde-titre">{{ s.titre }}</h2></div>
  <div class="corde-fil">
    <ul class="corde-photos">{% for i in s.items %}<li><svg class="pince" aria-hidden="true"><use href="#p-pince"/></svg><figure class="tirage"><button type="button" class="photo-ouvrir" data-i="{{ loop.index0 }}" aria-label="{{ 'Enlarge photo: ' if en else 'Agrandir la photo : ' }}{{ i.alt }}"><img src="{{ i.image }}" alt="{{ i.alt }}" width="600" height="600" loading="lazy"></button>{% if i.note %}<figcaption class="note">{{ i.note }}</figcaption>{% endif %}</figure></li>{% endfor %}</ul>
  </div>
  <p class="centre corde-tout"><button type="button" class="bouton secondaire photo-ouvrir" data-i="0">{{ s.voir_tout or ("See all the photos" if en else "Voir toutes les photos") }} ({{ s.items.length + s.plus.length }})</button></p>
  <dialog class="visite" id="visite" aria-label="{{ 'Tour of the estate in photos' if en else 'Visite du domaine en photos' }}">
    <button type="button" class="visite-fermer" aria-label="{{ 'Close' if en else 'Fermer' }}">×</button>
    <button type="button" class="visite-nav visite-prec" aria-label="{{ 'Previous photo' if en else 'Photo précédente' }}">‹</button>
    <figure class="visite-fig"><img class="visite-img" alt="" src=""><figcaption class="visite-legende"></figcaption></figure>
    <button type="button" class="visite-nav visite-suiv" aria-label="{{ 'Next photo' if en else 'Photo suivante' }}">›</button>
    <p class="visite-compteur" aria-live="polite"></p>
  </dialog>
  <script type="application/json" id="visite-donnees">{{ (s.items.concat(s.plus)) | dump | safe }}</script>
</section>
<script>
(function(){
  var d=document.getElementById("visite");if(!d||!d.showModal)return;
  var data=JSON.parse(document.getElementById("visite-donnees").textContent),i=0,dernier=null,
  img=d.querySelector(".visite-img"),leg=d.querySelector(".visite-legende"),cpt=d.querySelector(".visite-compteur");
  function voir(n){i=(n+data.length)%data.length;var p=data[i];img.src=p.image;img.alt=p.alt;leg.textContent=p.alt;cpt.textContent=(i+1)+" / "+data.length;
    var s=data[(i+1)%data.length],pr=new Image();pr.src=s.image}
  function ouvrir(n,el){dernier=el;voir(n);d.showModal();document.documentElement.classList.add("visite-ouverte")}
  document.querySelectorAll(".photo-ouvrir").forEach(function(b){b.addEventListener("click",function(){ouvrir(+b.dataset.i,b)})});
  d.querySelector(".visite-prec").addEventListener("click",function(){voir(i-1)});
  d.querySelector(".visite-suiv").addEventListener("click",function(){voir(i+1)});
  d.querySelector(".visite-fermer").addEventListener("click",function(){d.close()});
  d.addEventListener("click",function(e){if(e.target===d)d.close()});
  d.addEventListener("close",function(){document.documentElement.classList.remove("visite-ouverte");if(dernier)dernier.focus()});
  d.addEventListener("keydown",function(e){if(e.key==="ArrowLeft"){voir(i-1)}else if(e.key==="ArrowRight"){voir(i+1)}});
  var x0=null;d.addEventListener("touchstart",function(e){x0=e.touches[0].clientX},{passive:true});
  d.addEventListener("touchend",function(e){if(x0===null)return;var dx=e.changedTouches[0].clientX-x0;if(Math.abs(dx)>50)voir(i+(dx<0?1:-1));x0=null});
})();
</script>
