<section class="corde" aria-labelledby="corde-titre"><div class="conteneur"><p class="surtitre">{{ s.surtitre }}</p><h2 id="corde-titre">{{ s.titre }}</h2></div>
  <div class="corde-fil">
    <ul class="corde-photos">{% for i in s.items %}<li><svg class="pince" aria-hidden="true"><use href="#p-pince"/></svg><figure class="tirage"><img src="{{ i.image }}" alt="{{ i.alt }}" width="600" height="600" loading="lazy">{% if i.note %}<figcaption class="note">{{ i.note }}</figcaption>{% endif %}</figure></li>{% endfor %}</ul>
  </div>
</section>
