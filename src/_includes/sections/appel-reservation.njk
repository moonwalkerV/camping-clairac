{% set en = (lang == "en") %}<section class="appel-reservation"><div class="conteneur appel-in">
  <svg class="picto picto-grand" aria-hidden="true"><use href="#p-tente"/></svg>
  <h2>{{ s.titre }}</h2>
  <p>{{ s.intro }}</p>
  <div class="actions"><a class="bouton" href="{{ site.en.bouton_flottant.lien if en else site.bouton_flottant.lien }}">{{ s.b1 or ("Request a booking" if en else "Demander une réservation") }}</a><a class="bouton secondaire" href="tel:{{ site.contact.telephone | tel }}">{{ (s.b2 or ("Call" if en else "Appeler le")) }} {{ site.contact.telephone if en else site.contact.telephone_affiche }}</a></div>
</div></section>
