<section class="section offres-lignes" id="{{ s.ancre or 'offres' }}"><div class="conteneur">
  {% include "sections/_entete-section.njk" %}
  {% for i in s.items %}<article class="ligne">
    {% if i.image %}<img src="{{ i.image }}" alt="{{ i.alt }}" loading="lazy" width="720" height="540">{% endif %}
    <div class="ligne-texte">{% if i.detail %}<p class="surtitre">{{ i.detail }}</p>{% endif %}<h3>{{ i.titre }}</h3><p>{{ i.texte }}</p>{% if i.prix %}<p class="prix">{{ i.prix }}</p>{% endif %}</div>
  </article>{% endfor %}
</div></section>
