<section class="hero hero-scinde"><div class="conteneur hero-in">
  <div class="hero-texte">
    {% if s.surtitre %}<p class="surtitre">{{ s.surtitre }}</p>{% endif %}
    <h1>{{ s.titre or site.accroche }}</h1>
    {% if s.intro %}<p class="chapo">{{ s.intro }}</p>{% endif %}
    <div class="actions">
      {% if s.bouton %}<a class="bouton" href="{{ s.bouton.lien }}">{{ s.bouton.texte }}</a>{% endif %}
      <a class="bouton secondaire" href="tel:{{ site.contact.telephone | tel }}">Appeler</a>
    </div>
  </div>
  {% if s.image %}<img class="hero-img" src="{{ s.image }}" alt="{{ s.alt }}" width="640" height="560" fetchpriority="high">{% endif %}
</div></section>
