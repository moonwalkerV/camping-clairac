<section class="hero-carnet">
  <div class="hero-panneau"><div class="hero-texte">
    {% if s.surtitre %}<p class="surtitre">{{ s.surtitre }}</p>{% endif %}
    <h1>{{ s.titre }}</h1>
    <p class="chapo">{{ s.intro }}</p>
    <div class="actions">
      <a class="bouton" href="{{ site.bouton_flottant.lien }}">Demander une réservation</a>
      <a class="bouton secondaire" href="tel:{{ site.contact.telephone | tel }}"><svg class="picto" aria-hidden="true"><use href="#p-tel"/></svg>{{ site.contact.telephone_affiche }}</a>
    </div>
    <nav class="hero-choix" aria-label="Choisir votre séjour">
      <a href="/sejourner/#emplacements" class="hero-choix-lien">
        <span class="hero-choix-surtitre">Dormir sous les pins</span>
        <strong>Les emplacements <span aria-hidden="true">↗</span></strong>
        <span class="hero-choix-detail">Dès 25 € / nuit pour deux</span>
      </a>
      <a href="/sejourner/#gite" class="hero-choix-lien">
        <span class="hero-choix-surtitre">Poser ses valises</span>
        <strong>Le gîte <span aria-hidden="true">↗</span></strong>
        <span class="hero-choix-detail">Une maison au domaine</span>
      </a>
    </nav>
    <p class="meteo-court" data-meteo="court" aria-live="polite" aria-busy="true"></p>
  </div></div>
  <div class="hero-photo">
    <img src="{{ s.image }}" alt="{{ s.alt }}" width="765" height="1020" fetchpriority="high">
    <p class="note note-photo">{{ s.note }}</p>
    {% if s.image2 %}<figure class="tirage tirage-petit"><img src="{{ s.image2 }}" alt="{{ s.alt2 }}" width="600" height="530" loading="lazy"></figure>{% endif %}
  </div>
</section>
