<section class="section alentours-choix"><div class="conteneur">
  {% include "sections/_entete-section.njk" %}
  <div class="cartes-lieux">{% for t in alentours %}{% for p in t.places %}{% if p.name in s.noms %}<article class="lieu">
    {% if p.image %}<img src="{{ p.image | replace('/images/', '/assets/img/photos/') }}" alt="{{ p.alt }}" width="800" height="600" loading="lazy">{% endif %}
    <p class="lieu-cat">{{ t.label }}</p><h3>{{ p.name }}</h3>{% if p.subtitle %}<p class="lieu-sous">{{ p.subtitle }}</p>{% endif %}
  </article>{% endif %}{% endfor %}{% endfor %}</div>
  <p class="centre"><a class="lien-fleche" href="{{ s.bouton.lien }}">{{ s.bouton.texte }}</a></p>
</div></section>
