<header class="header">
  <a class="brand" href="/" aria-label="Camping Clairac, accueil actuel"><img src="{{ site.logo }}" alt="" width="62" height="62"><span>Camping<br><strong>Clairac</strong></span></a>
  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="navigation">Menu</button>
  <nav id="navigation" aria-label="Navigation principale"><ul>{% for item in site.navigation %}<li><a href="{{ item.lien }}">{{ item.texte }}</a></li>{% endfor %}</ul></nav>
  <a class="header-book" href="{{ site.bouton_flottant.lien }}">Réserver</a>
</header>

    <div class="hero-content">
      <p class="eyebrow">Aire naturelle de camping · Béziers</p>
