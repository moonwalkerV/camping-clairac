---
const quickLinks = [
  { label: "Le site", href: "/aire-naturelle" },
  { label: "Séjourner", href: "/sejourner" },
  { label: "Nos coups de cœur à proximité", href: "/nos-coups-de-coeur" },
  { label: "Galerie", href: "/galerie" },
  { label: "Infos pratiques", href: "/infos-pratiques" },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__logo">Camping Clairac</p>
      <p class="site-footer__tagline">Une parenthèse nature aux portes de Béziers</p>
    </div>

    <nav class="site-footer__links" aria-label="Liens rapides">
      <p class="site-footer__heading">Liens rapides</p>
      <ul>
        {quickLinks.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__contact">
      <p class="site-footer__heading">Contact</p>
      <p>Domaine de Clairac, Route de Bessan (D28), 34500 Béziers</p>
      <p><a href="tel:+33611199813">+33 6 11 19 98 13</a></p>
      <p><a href="mailto:info@campingclairac.com">info@campingclairac.com</a></p>
    </div>
  </div>

  <div class="site-footer__bottom">
    <p>&copy; {new Date().getFullYear()} Camping Clairac. Tous droits réservés.</p>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-forest);
    color: var(--color-cream);
    margin-top: 4rem;
  }

  .site-footer__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 1.5rem 2rem;
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 2rem;
  }

  .site-footer__logo {
    font-family: var(--font-heading);
    font-size: 1.5rem;
  }

  .site-footer__tagline {
    margin-top: 0.5rem;
    color: var(--color-sand);
  }

  .site-footer__heading {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }

  .site-footer__links ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .site-footer__links a,
  .site-footer__contact a {
    color: var(--color-cream);
    opacity: 0.85;
  }

  .site-footer__links a:hover,
  .site-footer__contact a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .site-footer__contact p {
    margin-bottom: 0.4rem;
    opacity: 0.85;
  }

  .site-footer__bottom {
    border-top: 1px solid var(--color-sage);
    text-align: center;
    padding: 1rem 1.5rem;
    font-size: 0.85rem;
    opacity: 0.7;
  }

  @media (max-width: 700px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
