---
const navItems = [
  { label: "Le site", href: "/aire-naturelle" },
  { label: "Séjourner", href: "/sejourner" },
  { label: "Nos coups de cœur à proximité", href: "/nos-coups-de-coeur" },
  { label: "Galerie", href: "/galerie" },
  { label: "Infos pratiques", href: "/infos-pratiques" },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__logo">
      <img src="/images/logo-camping-clairac.png" alt="Logo Camping Clairac" />
      <span>Camping Clairac</span>
    </a>

    <nav class="site-header__nav" aria-label="Navigation principale">
      <ul>
        {navItems.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <a href="/infos-pratiques/contact" class="site-header__cta">Réserver</a>
  </div>
</header>

<style>
  .site-header {
    background-color: var(--color-cream);
    border-bottom: 1px solid var(--color-sand);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .site-header__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-header__logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    white-space: nowrap;
  }

  .site-header__logo img {
    height: 80px;
    width: auto;
  }

  .site-header__logo span {
    font-family: 'Bryndan Write', cursive;
    font-size: 1.9rem;
    color: var(--color-forest);
    text-transform: uppercase;
  }

  .site-header__nav {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
  }

  .site-header__nav ul {
    list-style: none;
    display: flex;
    gap: 1.75rem;
    justify-content: center;
    white-space: nowrap;
  }

  .site-header__nav a {
    font-family: var(--font-body);
    font-weight: 500;
    color: var(--color-forest);
    transition: color 0.2s ease;
  }

  .site-header__nav a:hover {
    color: var(--color-sage);
  }

  .site-header__cta {
    background-color: var(--color-forest);
    color: var(--color-cream);
    font-weight: 600;
    padding: 0.6rem 1.25rem;
    border-radius: 999px;
    white-space: nowrap;
    transition: background-color 0.2s ease;
  }

  .site-header__cta:hover {
    background-color: var(--color-sage);
  }

  @media (max-width: 860px) {
    .site-header__inner {
      flex-wrap: wrap;
    }

    .site-header__logo img {
      height: 56px;
    }

    .site-header__logo span {
      font-size: 1.4rem;
    }

    .site-header__nav {
      order: 3;
      width: 100%;
    }

    .site-header__nav ul {
      justify-content: flex-start;
      gap: 1.25rem;
      padding-bottom: 0.25rem;
    }
  }

  @media (max-width: 400px) {
    .site-header__logo img {
      height: 44px;
    }

    .site-header__logo span {
      font-size: 1.1rem;
    }

    .site-header__cta {
      padding: 0.55rem 1rem;
      font-size: 0.9rem;
    }
  }
</style>
