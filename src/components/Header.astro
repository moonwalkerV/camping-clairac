---
const navItems = [
  { label: "Le site", href: "/aire-naturelle" },
  { label: "Séjourner", href: "/sejourner" },
  { label: "Nos coups de cœur à proximité", href: "/nos-coups-de-coeur" },
  { label: "Galerie", href: "/galerie" },
  { label: "Infos pratiques", href: "/infos-pratiques" },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__logo">
      <img src="/images/logo-camping-clairac.png" alt="Logo Camping Clairac" />
      <span>Camping Clairac</span>
    </a>

    <nav class="site-header__nav" aria-label="Navigation principale">
      <ul>
        {navItems.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href="/infos-pratiques/contact" class="site-header__cta">Réserver</a>

      <button
        type="button"
        class="site-header__burger"
        data-menu-toggle
        aria-label="Ouvrir le menu"
        aria-expanded="false"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <nav class="site-header__mobile-nav" data-mobile-nav aria-label="Navigation mobile">
    <ul>
      {navItems.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    background-color: var(--color-cream);
    border-bottom: 1px solid var(--color-sand);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .site-header__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .site-header__logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    white-space: nowrap;
  }

  .site-header__logo img {
    height: 80px;
    width: auto;
  }

  .site-header__logo span {
    font-family: 'Bryndan Write', cursive;
    font-size: 1.9rem;
    color: var(--color-forest);
    text-transform: uppercase;
  }

  .site-header__nav {
    flex: 1;
    min-width: 0;
  }

  .site-header__nav ul {
    list-style: none;
    display: flex;
    gap: 1.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .site-header__nav a {
    font-family: var(--font-body);
    font-weight: 500;
    color: var(--color-forest);
    transition: color 0.2s ease;
  }

  .site-header__nav a:hover {
    color: var(--color-sage);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .site-header__cta {
    background-color: var(--color-forest);
    color: var(--color-cream);
    font-weight: 600;
    padding: 0.6rem 1.25rem;
    border-radius: 999px;
    white-space: nowrap;
    transition: background-color 0.2s ease;
  }

  .site-header__cta:hover {
    background-color: var(--color-sage);
  }

  .site-header__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: none;
    flex-shrink: 0;
  }

  .site-header__burger span {
    display: block;
    width: 22px;
    height: 2px;
    background-color: var(--color-forest);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .site-header__burger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .site-header__burger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .site-header__burger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .site-header__mobile-nav {
    display: none;
  }

  @media (max-width: 860px) {
    .site-header__inner {
      gap: 0.75rem;
    }

    .site-header__actions {
      gap: 0.5rem;
    }

    .site-header__nav {
      display: none;
    }

    .site-header__burger {
      display: flex;
    }

    .site-header__mobile-nav {
      display: block;
      max-height: 0;
      overflow-y: auto;
      overflow-x: hidden;
      transition: max-height 0.25s ease;
      border-top: 1px solid transparent;
    }

    .site-header__mobile-nav.is-open {
      max-height: min(60vh, 420px);
      border-top-color: var(--color-sand);
    }

    .site-header__mobile-nav ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      padding: 0.5rem 1.5rem 1rem;
    }

    .site-header__mobile-nav li {
      border-bottom: 1px solid var(--color-sand);
    }

    .site-header__mobile-nav li:last-child {
      border-bottom: none;
    }

    .site-header__mobile-nav a {
      display: block;
      padding: 0.85rem 0;
      font-family: var(--font-body);
      font-weight: 500;
      color: var(--color-forest);
    }

    .site-header__logo img {
      height: 56px;
    }

    .site-header__logo span {
      font-size: 1.4rem;
    }
  }

  @media (max-width: 480px) {
    .site-header__inner {
      padding: 1rem;
      gap: 0.5rem;
    }

    .site-header__logo {
      gap: 0.5rem;
    }

    .site-header__logo img {
      height: 40px;
    }

    .site-header__logo span {
      font-size: 0.95rem;
    }

    .site-header__actions {
      gap: 0.4rem;
    }

    .site-header__cta {
      padding: 0.5rem 0.85rem;
      font-size: 0.85rem;
    }

    .site-header__burger {
      width: 36px;
      height: 36px;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLElement>('[data-menu-toggle]');
  const mobileNav = document.querySelector<HTMLElement>('[data-mobile-nav]');

  if (toggle && mobileNav) {
    const closeMenu = () => {
      toggle.setAttribute('aria-expanded', 'false');
      mobileNav.classList.remove('is-open');
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      mobileNav.classList.toggle('is-open', !isOpen);
    });

    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 860) closeMenu();
    });
  }
</script>
