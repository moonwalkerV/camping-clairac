<section class="weather-widget" data-weather-widget aria-labelledby="weather-widget-title">
  <h2 id="weather-widget-title" class="weather-widget__title">Météo à Béziers en direct</h2>

  <div class="weather-widget__main" data-weather-main aria-live="polite" aria-busy="true">
    <span class="weather-widget__main-icon" data-weather-main-icon aria-hidden="true">🌤️</span>
    <div>
      <p class="weather-widget__main-day">En ce moment</p>
      <p class="weather-widget__main-temp" data-weather-main-temp>Chargement…</p>
      <p class="weather-widget__main-desc" data-weather-main-desc></p>
    </div>
  </div>

  <div class="weather-widget__days" data-weather-days></div>
</section>

<style>
  .weather-widget {
    max-width: 760px;
    margin: 2rem 0;
  }

  .weather-widget__title {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.5vw, 1.9rem);
    margin-bottom: 0.75rem;
  }

  .weather-widget__main {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem;
    margin-bottom: 0.75rem;
    background-color: var(--color-cream);
    color: var(--color-forest);
    border: 1px solid rgba(36, 56, 44, 0.12);
    border-radius: 16px;
    box-shadow: 0 6px 16px rgba(36, 56, 44, 0.12);
    transition: background 0.4s ease, color 0.4s ease;
  }

  .weather-widget__main-icon {
    font-size: 3rem;
    line-height: 1;
  }

  .weather-widget__main-day {
    margin: 0 0 0.15rem;
    font-weight: 700;
  }

  .weather-widget__main-temp {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
  }

  .weather-widget__main-desc {
    margin: 0.15rem 0 0;
    opacity: 0.9;
  }

  /* Dynamic backgrounds per weather condition */
  .weather-widget__main[data-condition="Clear"] {
    background: linear-gradient(135deg, #fde68a, #7dd3fc);
    color: var(--color-forest);
  }

  .weather-widget__main[data-condition="Clouds"] {
    background: linear-gradient(135deg, #d7dbe0, #9aa3ac);
    color: var(--color-forest);
  }

  .weather-widget__main[data-condition="Rain"],
  .weather-widget__main[data-condition="Drizzle"] {
    background: linear-gradient(135deg, #64748b, #2f3d52);
    color: var(--color-cream);
  }

  .weather-widget__main[data-condition="Thunderstorm"] {
    background: linear-gradient(135deg, #4b5568, #2c2440);
    color: var(--color-cream);
  }

  .weather-widget__main[data-condition="Snow"] {
    background: linear-gradient(135deg, #ffffff, #dbeafe);
    color: var(--color-forest);
  }

  .weather-widget__main[data-condition="Mist"],
  .weather-widget__main[data-condition="Fog"],
  .weather-widget__main[data-condition="Haze"] {
    background: linear-gradient(135deg, #e8e8e8, #cfcfcf);
    color: var(--color-forest);
  }

  .weather-widget__days {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.75rem;
  }

  .weather-widget__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.4rem;
    padding: 1rem 0.75rem;
    background-color: var(--color-cream);
    border: 1px solid rgba(36, 56, 44, 0.12);
    border-radius: 16px;
    box-shadow: 0 6px 16px rgba(36, 56, 44, 0.12);
  }

  .weather-widget__icon {
    font-size: 2rem;
    line-height: 1;
  }

  .weather-widget__day {
    margin: 0;
    font-weight: 700;
    text-transform: capitalize;
  }

  .weather-widget__temps {
    margin: 0;
    font-weight: 600;
  }

  .weather-widget__details {
    margin: 0;
    color: var(--color-sage);
  }

  @media (max-width: 700px) {
    .weather-widget__main {
      padding: 1.25rem;
    }

    .weather-widget__days {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 480px) {
    .weather-widget__main {
      flex-direction: column;
      text-align: center;
    }

    .weather-widget__days {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  const widget = document.querySelector<HTMLElement>('[data-weather-widget]');

  if (widget) {
    const mainCard = widget.querySelector<HTMLElement>('[data-weather-main]');
    const mainIcon = widget.querySelector<HTMLElement>('[data-weather-main-icon]');
    const mainTemp = widget.querySelector<HTMLElement>('[data-weather-main-temp]');
    const mainDesc = widget.querySelector<HTMLElement>('[data-weather-main-desc]');
    const daysContainer = widget.querySelector<HTMLElement>('[data-weather-days]');
    const apiKey = import.meta.env.PUBLIC_OPENWEATHER_API_KEY;

    interface ForecastEntry {
      dt: number;
      main: { temp: number; temp_min: number; temp_max: number };
      weather: { id: number; main: string; description: string; icon: string }[];
    }

    interface CurrentWeather {
      main: { temp: number };
      weather: { id: number; main: string; description: string; icon: string }[];
    }

    const getWeatherIcon = (conditionId: number, iconCode: string) => {
      if (conditionId >= 200 && conditionId < 300) return '⛈️';
      if (conditionId >= 300 && conditionId < 500) return '🌦️';
      if (conditionId >= 500 && conditionId < 600) return '🌧️';
      if (conditionId >= 600 && conditionId < 700) return '❄️';
      if (conditionId >= 700 && conditionId < 800) return '🌫️';
      if (conditionId === 800) return iconCode.endsWith('n') ? '🌙' : '☀️';
      if (conditionId === 801) return '🌤️';
      return '☁️';
    };

    const showUnavailableState = () => {
      mainCard?.setAttribute('aria-busy', 'false');
      mainCard?.removeAttribute('data-condition');
      if (mainIcon) mainIcon.textContent = '○';
      if (mainTemp) mainTemp.textContent = 'Météo indisponible';
      if (mainDesc) mainDesc.textContent = 'Réessayez un peu plus tard.';
      if (daysContainer) daysContainer.innerHTML = '';
    };

    const groupByDay = (list: ForecastEntry[]) => {
      const days = new Map<string, ForecastEntry[]>();

      list.forEach((entry) => {
        const date = new Date(entry.dt * 1000);
        const key = date.toISOString().slice(0, 10);
        if (!days.has(key)) days.set(key, []);
        days.get(key)!.push(entry);
      });

      return Array.from(days.entries()).slice(0, 6);
    };

    const pickRepresentativeEntry = (entries: ForecastEntry[]) => {
      return (
        entries.find((entry) => {
          const hour = new Date(entry.dt * 1000).getHours();
          return hour >= 12 && hour <= 15;
        }) ?? entries[Math.floor(entries.length / 2)]
      );
    };

    const loadWeather = async () => {
      if (!apiKey) {
        showUnavailableState();
        return;
      }

      try {
        const params = new URLSearchParams({
          lat: '43.3442',
          lon: '3.2158',
          units: 'metric',
          lang: 'fr',
          appid: apiKey,
        });

        const [currentResponse, forecastResponse] = await Promise.all([
          fetch(`https://api.openweathermap.org/data/2.5/weather?${params}`),
          fetch(`https://api.openweathermap.org/data/2.5/forecast?${params}`),
        ]);

        if (!currentResponse.ok || !forecastResponse.ok) throw new Error('Weather request failed');

        const currentData: CurrentWeather = await currentResponse.json();
        const forecastData = await forecastResponse.json();
        const list: ForecastEntry[] = forecastData.list;

        if (!Array.isArray(list) || list.length === 0) throw new Error('Incomplete weather data');

        const currentWeather = currentData.weather?.[0];
        if (!currentWeather || typeof currentData.main?.temp !== 'number') {
          throw new Error('Incomplete current weather data');
        }

        const currentDescription =
          currentWeather.description.charAt(0).toUpperCase() + currentWeather.description.slice(1);

        if (mainCard) mainCard.setAttribute('data-condition', currentWeather.main);
        if (mainIcon) mainIcon.textContent = getWeatherIcon(currentWeather.id, currentWeather.icon ?? '');
        if (mainTemp) mainTemp.textContent = `${Math.round(currentData.main.temp)} °C`;
        if (mainDesc) mainDesc.textContent = currentDescription;
        mainCard?.setAttribute('aria-busy', 'false');

        const dayGroups = groupByDay(list);
        const [, ...nextGroups] = dayGroups;

        if (daysContainer) {
          daysContainer.innerHTML = nextGroups
            .map(([dateKey, entries]) => {
              const representative = pickRepresentativeEntry(entries);
              const weather = representative.weather[0];
              const dayLabel = new Date(`${dateKey}T12:00:00`).toLocaleDateString('fr-FR', {
                weekday: 'short',
              });

              return `
                <div class="weather-widget__card">
                  <p class="weather-widget__day">${dayLabel}</p>
                  <span class="weather-widget__icon" aria-hidden="true">${getWeatherIcon(weather.id, weather.icon ?? '')}</span>
                  <p class="weather-widget__temps">${Math.round(representative.main.temp)}°</p>
                </div>
              `;
            })
            .join('');
        }
      } catch {
        showUnavailableState();
      }
    };

    loadWeather();
  }
</script>
