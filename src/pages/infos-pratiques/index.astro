---
import Layout from '../../layouts/Layout.astro';
import WeatherWidget from '../../components/WeatherWidget.astro';

const mapsEmbedSrc = 'https://www.google.com/maps?q=43.362408,3.319105&output=embed';
const appleMapsHref = 'https://maps.apple.com/?address=34500%20B%C3%A9ziers,%20France&auid=13666031460363364111&ll=43.362434,3.319060&lsp=9902&q=Camping%20Clairac&t=m';
const googleMapsHref = 'https://www.google.com/maps/search/?api=1&query=43.362408,3.319105';

const itineraries = [
  {
    title: "Par l'A9",
    steps: "Sortie n°35 « Béziers Centre ». Au 1er rond-point, direction Béziers-Centre. Au 2ème et 3ème rond-point, direction Pézenas. Au 4ème rond-point, direction N9/PAE La Baume. Tout droit pendant 3,5 km sur la N9, puis à droite vers « Domaine de Clairac / Camping Clairac ».",
  },
  {
    title: "Par l'A75",
    steps: "Sortie n°63 « Béziers-Centre ». Au rond-point, à droite, direction N9/PAE La Baume. Tout droit pendant 3,5 km sur la N9, puis à droite vers « Domaine de Clairac / Camping Clairac ».",
  },
];
---

<Layout title="Infos pratiques — Camping Clairac">
  <section id="meteo" class="section section--alt">
    <div class="section__inner">
      <WeatherWidget />
    </div>
  </section>

  <section id="acces" class="section">
    <div class="section__inner">
      <h1>Accès</h1>
      <p class="acces-intro">
        Le camping s'installe sur le Domaine de Clairac, un ancien domaine
        viticole niché au milieu des vignes et des oliviers, à 5 km du
        centre-ville de Béziers, 15 km de la Méditerranée et 20 km des
        premiers reliefs de l'Hérault et des Cévennes. L'entrée du domaine se
        trouve côté sud de la route nationale N9/N113, à 5 km de Béziers et
        15 km de Pézenas.
      </p>

      <div class="gps-notice">
        <p class="gps-notice__title">
          Suivez nos indications ou votre GPS, jamais les deux à la fois.
        </p>
        <p>
          Pour votre GPS, n'utilisez pas notre adresse postale mais l'adresse
          suivante : <strong>Allée de Clairac, Béziers</strong>. Coordonnées
          précises : 43.362408, 3.319105 (43°21'44.6"N 3°19'08.8"E).
        </p>
      </div>

      <div class="maps-links">
        <a href={appleMapsHref} target="_blank" rel="noopener noreferrer" class="btn btn--primary">
          Ouvrir dans Apple Maps
        </a>
        <a href={googleMapsHref} target="_blank" rel="noopener noreferrer" class="btn btn--primary">
          Ouvrir dans Google Maps
        </a>
      </div>

      <div class="map-wrapper">
        <iframe
          src={mapsEmbedSrc}
          width="100%"
          height="400"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Carte d'accès au Domaine de Clairac"
        ></iframe>
      </div>

      <figure class="access-photo">
        <img
          src="/images/chemin-terre-acces-chiens.webp"
          alt="Chemin d'accès au camping"
          loading="lazy"
        />
        <figcaption>
          Les derniers kilomètres se font sur un chemin de terre en bon état,
          à l'image d'une véritable aire naturelle.
        </figcaption>
      </figure>

      <div class="itineraries">
        {itineraries.map((itinerary) => (
          <div class="itinerary-card">
            <h3>{itinerary.title}</h3>
            <p>{itinerary.steps}</p>
          </div>
        ))}
      </div>

      <p class="postal-address">
        Adresse postale, pour le courrier (pas pour le GPS) : Domaine de
        Clairac, Route de Bessan, 34500 Béziers, France.
      </p>
    </div>
  </section>

  <section id="infos" class="section section--alt">
    <div class="section__inner section__inner--wide">
      <h2>Informations pratiques</h2>
      <img
        src="/images/camping-reception.webp"
        alt="Accueil et réception du camping"
        class="infos-photo"
        loading="lazy"
      />
      <div class="infos-grid">
        <div class="infos-card">
          <div class="infos-card__icon" aria-hidden="true">📅</div>
          <p class="infos-card__label">Période d'ouverture</p>
          <p class="infos-card__value">Avril à Octobre</p>
        </div>
        <div class="infos-card">
          <div class="infos-card__icon" aria-hidden="true">🚪</div>
          <p class="infos-card__label">Horaires du portail</p>
          <p class="infos-card__value">Ouvert de 7h30 à 22h30</p>
        </div>
        <div class="infos-card">
          <div class="infos-card__icon" aria-hidden="true">📩</div>
          <p class="infos-card__label">Réservation</p>
          <div class="infos-card__actions">
            <a href="mailto:info@campingclairac.com" class="infos-card__btn">✉️ Email</a>
            <a href="tel:+33611199813" class="infos-card__btn">📞 Téléphone</a>
          </div>
          <p class="infos-card__value infos-card__note">
            Pas de réservation en ligne pour l'instant.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="plan" class="section">
    <div class="section__inner section__inner--wide">
      <h2>Plan du camping</h2>
      <button type="button" class="plan-link" data-lightbox-trigger aria-label="Agrandir le plan du camping">
        <img
          src="/images/plan-du-camping.webp"
          alt="Plan du camping avec emplacements numérotés, sanitaires, aire de jeux et équipements de sécurité incendie"
          class="plan-image"
          loading="lazy"
        />
      </button>
      <a href="/images/plan-du-camping.webp" target="_blank" rel="noopener noreferrer" class="plan-fullscreen-link">
        Voir en plein écran
      </a>
    </div>
  </section>

  <section id="reglement" class="section section--alt">
    <div class="section__inner">
      <h2>Nous sommes en zone de vigilance feu de forêt</h2>
      <div class="fire-notice">
        <div class="fire-notice__media">
          <img
            src="/images/icone-risque-incendie.webp"
            alt="Icône représentant un risque de feu de forêt"
            class="fire-notice__icon"
            loading="lazy"
          />
        </div>
        <p>
          Comme une grande partie du Sud de la France, notre région a été
          touchée par plusieurs feux de forêt lors des étés précédents. Le
          camping se situe en zone classée à risque fort de feu de forêt :
          les feux ouverts et les barbecues au sol sont strictement
          interdits, seuls les barbecues électriques ou à gaz sont autorisés
          (une seule bouteille de gaz par installation). Merci à chacun de
          rester vigilant, de ne jamais jeter de mégot au sol et de
          respecter scrupuleusement ces consignes : la sécurité de tous,
          campeurs comme forêt environnante, en dépend.
        </p>
      </div>
    </div>
  </section>

  <div id="lightbox" class="lightbox" data-lightbox>
    <button type="button" class="lightbox__close" data-lightbox-close aria-label="Fermer">&times;</button>
    <img src="/images/plan-du-camping.webp" alt="Plan du camping en plein écran" class="lightbox__image" />
  </div>

  <section id="contact" class="section">
    <div class="section__inner">
      <h2>Nous contacter</h2>
      <p>
        <a href="tel:+33611199813" class="contact-link">📞 +33 6 11 19 98 13</a>
      </p>
      <p>
        <a href="mailto:info@campingclairac.com" class="contact-link">✉️ info@campingclairac.com</a>
      </p>
      <p class="note">
        Le formulaire de contact en ligne sera ajouté dans une prochaine itération du site.
      </p>
    </div>
  </section>
</Layout>

<style>
  .section {
    padding: 4rem 1.5rem;
  }

  .section--alt {
    background-color: var(--color-sand);
  }

  .section__inner {
    max-width: 700px;
    margin: 0 auto;
  }

  .section__inner h1,
  .section__inner h2 {
    margin-bottom: 1rem;
  }

  .acces-intro {
    margin-bottom: 1.5rem;
  }

  .gps-notice {
    background-color: var(--color-cream);
    border-left: 4px solid var(--color-earth);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
  }

  .gps-notice__title {
    font-weight: 600;
    color: var(--color-forest);
    margin-bottom: 0.5rem;
  }

  .maps-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .itineraries {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 1.5rem 0;
  }

  .itinerary-card {
    background-color: #fff;
    border: 1px solid var(--color-sand);
    border-radius: 16px;
    padding: 1.5rem;
    box-shadow: 0 4px 16px rgba(36, 56, 44, 0.06);
  }

  .itinerary-card h3 {
    margin-bottom: 0.5rem;
    color: var(--color-forest);
  }

  .itinerary-card p {
    margin: 0;
    font-size: 0.9rem;
  }

  .postal-address {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-earth);
    font-style: italic;
  }

  .map-wrapper {
    margin: 1.5rem 0;
    border-radius: 12px;
    overflow: hidden;
  }

  .map-wrapper iframe {
    display: block;
  }

  .access-photo {
    margin: 1.5rem 0;
  }

  .access-photo img {
    display: block;
    width: 100%;
    height: 280px;
    object-fit: cover;
    border-radius: 12px;
  }

  .access-photo figcaption {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: var(--color-earth);
    font-style: italic;
  }

  .infos-photo {
    display: block;
    width: 100%;
    max-width: 700px;
    height: 280px;
    object-fit: cover;
    border-radius: 12px;
    margin: 0 auto 2rem;
  }

  .infos-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .infos-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.6rem;
    background-color: #fff;
    border: 1px solid var(--color-sand);
    border-radius: 16px;
    padding: 1.75rem 1.25rem;
    box-shadow: 0 4px 16px rgba(36, 56, 44, 0.06);
  }

  .infos-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: rgba(104, 122, 90, 0.15);
    font-size: 2rem;
    line-height: 1;
  }

  .infos-card__label {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-forest);
  }

  .infos-card__value {
    margin: 0;
  }

  .infos-card__actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .infos-card__btn {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background-color: var(--color-forest);
    color: var(--color-cream);
    font-weight: 600;
    font-size: 0.9rem;
    transition: background-color 0.2s ease;
  }

  .infos-card__btn:hover {
    background-color: var(--color-sage);
  }

  .infos-card__note {
    font-size: 0.85rem;
    color: var(--color-earth);
    font-style: italic;
  }

  .contact-link {
    display: inline-block;
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
    color: var(--color-forest);
  }

  .note {
    font-size: 0.85rem;
    color: var(--color-earth);
    font-style: italic;
    margin-top: 1rem;
  }

  .btn {
    display: inline-block;
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    font-weight: 600;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .btn--primary {
    background-color: var(--color-forest);
    color: var(--color-cream);
  }

  .btn--primary:hover {
    background-color: var(--color-sage);
  }

  .section__inner--wide {
    max-width: 1000px;
    text-align: center;
  }

  .plan-link {
    display: block;
    width: 100%;
    max-width: 900px;
    margin: 1.5rem auto 1rem;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    border-radius: 12px;
    overflow: hidden;
  }

  .plan-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--color-sand);
  }

  .plan-fullscreen-link {
    display: inline-block;
    font-weight: 600;
    color: var(--color-forest);
    text-decoration: underline;
  }

  .fire-notice {
    display: flex;
    align-items: stretch;
    background-color: #fff;
    border-left: 4px solid var(--color-earth);
    border-radius: 8px;
    overflow: hidden;
    text-align: left;
  }

  .fire-notice__media {
    flex: 0 0 340px;
  }

  .fire-notice__icon {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .fire-notice p {
    margin: 0;
    padding: 1.5rem;
  }

  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background-color: rgba(36, 56, 44, 0.9);
  }

  .lightbox.active {
    display: flex;
  }

  .lightbox__image {
    max-width: 100%;
    max-height: 100%;
    border-radius: 8px;
  }

  .lightbox__close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background-color: rgba(244, 241, 232, 0.15);
    color: var(--color-cream);
    font-size: 1.75rem;
    line-height: 1;
    border: none;
    cursor: pointer;
  }

  .lightbox__close:hover {
    background-color: rgba(244, 241, 232, 0.3);
  }

  @media (max-width: 800px) {
    .infos-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .itineraries {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .fire-notice {
      flex-direction: column;
      text-align: center;
    }

    .fire-notice__media {
      flex: none;
      width: 100%;
      height: 220px;
    }
  }
</style>

<script>
  const trigger = document.querySelector<HTMLElement>('[data-lightbox-trigger]');
  const lightbox = document.querySelector<HTMLElement>('[data-lightbox]');
  const closeBtn = document.querySelector<HTMLElement>('[data-lightbox-close]');

  if (trigger && lightbox && closeBtn) {
    const openLightbox = () => {
      lightbox.classList.add('active');
    };

    const closeLightbox = () => {
      lightbox.classList.remove('active');
    };

    trigger.addEventListener('click', openLightbox);
    closeBtn.addEventListener('click', closeLightbox);

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });
  }
</script>
