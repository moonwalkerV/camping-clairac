---
import Layout from '../../layouts/Layout.astro';
import WeatherWidget from '../../components/WeatherWidget.astro';

const mapsEmbedSrc = 'https://www.google.com/maps?q=Domaine+de+Clairac,+Route+de+Bessan,+34500+B%C3%A9ziers&output=embed';
const mapsDirectionsHref = 'https://www.google.com/maps/dir/?api=1&destination=Domaine+de+Clairac+Route+de+Bessan+34500+Beziers';
---

<Layout title="Infos pratiques — Camping Clairac">
  <section id="acces" class="section">
    <div class="section__inner">
      <h1>Accès</h1>
      <p class="address">Domaine de Clairac, Route de Bessan (D28), 34500 Béziers</p>
      <p>
        Le camping dispose d'un second accès par la Route de Pézénas (N9),
        accessible en sortant à la sortie Béziers de l'A75.
      </p>

      <WeatherWidget />

      <div class="map-wrapper">
        <iframe
          src={mapsEmbedSrc}
          width="100%"
          height="400"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Carte d'accès au Domaine de Clairac"
        ></iframe>
      </div>

      <figure class="access-photo">
        <img
          src="/images/chemin-terre-acces-chiens.webp"
          alt="Chemin d'accès au camping"
          loading="lazy"
        />
        <figcaption>
          Les derniers kilomètres se font sur un chemin de terre en bon état,
          à l'image d'une véritable aire naturelle.
        </figcaption>
      </figure>

      <a href={mapsDirectionsHref} target="_blank" rel="noopener noreferrer" class="btn btn--primary">
        Ouvrir l'itinéraire
      </a>
    </div>
  </section>

  <section id="infos" class="section section--alt">
    <div class="section__inner">
      <h2>Informations pratiques</h2>
      <dl class="infos-list">
        <div class="infos-list__item">
          <dt>Période d'ouverture</dt>
          <dd>Avril à Octobre</dd>
        </div>
        <div class="infos-list__item">
          <dt>Horaires du portail</dt>
          <dd>Ouvert de 7h30 à 22h30</dd>
        </div>
        <div class="infos-list__item">
          <dt>Réservation</dt>
          <dd>
            Uniquement par email (<a href="mailto:info@campingclairac.com">info@campingclairac.com</a>)
            ou téléphone (<a href="tel:+33611199813">+33 6 11 19 98 13</a>).
            Pas de réservation en ligne pour l'instant.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section id="plan" class="section">
    <div class="section__inner section__inner--wide">
      <h2>Plan du camping</h2>
      <button type="button" class="plan-link" data-lightbox-trigger aria-label="Agrandir le plan du camping">
        <img
          src="/images/plan-du-camping.webp"
          alt="Plan du camping avec emplacements numérotés, sanitaires, aire de jeux et équipements de sécurité incendie"
          class="plan-image"
          loading="lazy"
        />
      </button>
      <a href="/images/plan-du-camping.webp" target="_blank" rel="noopener noreferrer" class="plan-fullscreen-link">
        Voir en plein écran
      </a>
    </div>
  </section>

  <section id="reglement" class="section section--alt">
    <div class="section__inner">
      <h2>Bon à savoir avant votre arrivée</h2>
      <div class="fire-notice">
        <p>
          Comme une grande partie du Sud de la France, notre région a été
          touchée par plusieurs feux de forêt lors des étés précédents. Le
          camping se situe en zone classée à risque fort de feu de forêt :
          les feux ouverts et les barbecues au sol sont strictement
          interdits, seuls les barbecues électriques ou à gaz sont autorisés
          (une seule bouteille de gaz par installation). Merci à chacun de
          rester vigilant, de ne jamais jeter de mégot au sol et de
          respecter scrupuleusement ces consignes : la sécurité de tous,
          campeurs comme forêt environnante, en dépend.
        </p>
      </div>
    </div>
  </section>

  <div id="lightbox" class="lightbox" data-lightbox>
    <button type="button" class="lightbox__close" data-lightbox-close aria-label="Fermer">&times;</button>
    <img src="/images/plan-du-camping.webp" alt="Plan du camping en plein écran" class="lightbox__image" />
  </div>

  <section id="contact" class="section">
    <div class="section__inner">
      <h2>Nous contacter</h2>
      <p>
        <a href="tel:+33611199813" class="contact-link">📞 +33 6 11 19 98 13</a>
      </p>
      <p>
        <a href="mailto:info@campingclairac.com" class="contact-link">✉️ info@campingclairac.com</a>
      </p>
      <p class="note">
        Le formulaire de contact en ligne sera ajouté dans une prochaine itération du site.
      </p>
    </div>
  </section>
</Layout>

<style>
  .section {
    padding: 4rem 1.5rem;
  }

  .section--alt {
    background-color: var(--color-sand);
  }

  .section__inner {
    max-width: 700px;
    margin: 0 auto;
  }

  .section__inner h1,
  .section__inner h2 {
    margin-bottom: 1rem;
  }

  .address {
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .map-wrapper {
    margin: 1.5rem 0;
    border-radius: 12px;
    overflow: hidden;
  }

  .map-wrapper iframe {
    display: block;
  }

  .access-photo {
    margin: 1.5rem 0;
  }

  .access-photo img {
    display: block;
    width: 100%;
    height: 280px;
    object-fit: cover;
    border-radius: 12px;
  }

  .access-photo figcaption {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: var(--color-earth);
    font-style: italic;
  }

  .infos-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .infos-list__item dt {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-forest);
    margin-bottom: 0.25rem;
  }

  .infos-list__item dd {
    margin: 0;
  }

  .contact-link {
    display: inline-block;
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
    color: var(--color-forest);
  }

  .note {
    font-size: 0.85rem;
    color: var(--color-earth);
    font-style: italic;
    margin-top: 1rem;
  }

  .btn {
    display: inline-block;
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    font-weight: 600;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .btn--primary {
    background-color: var(--color-forest);
    color: var(--color-cream);
  }

  .btn--primary:hover {
    background-color: var(--color-sage);
  }

  .section__inner--wide {
    max-width: 1000px;
    text-align: center;
  }

  .plan-link {
    display: block;
    width: 100%;
    max-width: 900px;
    margin: 1.5rem auto 1rem;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    border-radius: 12px;
    overflow: hidden;
  }

  .plan-image {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--color-sand);
  }

  .plan-fullscreen-link {
    display: inline-block;
    font-weight: 600;
    color: var(--color-forest);
    text-decoration: underline;
  }

  .fire-notice {
    background-color: #fff;
    border-left: 4px solid var(--color-earth);
    border-radius: 8px;
    padding: 1.5rem;
    text-align: left;
  }

  .fire-notice p {
    margin: 0;
  }

  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background-color: rgba(36, 56, 44, 0.9);
  }

  .lightbox.active {
    display: flex;
  }

  .lightbox__image {
    max-width: 100%;
    max-height: 100%;
    border-radius: 8px;
  }

  .lightbox__close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background-color: rgba(244, 241, 232, 0.15);
    color: var(--color-cream);
    font-size: 1.75rem;
    line-height: 1;
    border: none;
    cursor: pointer;
  }

  .lightbox__close:hover {
    background-color: rgba(244, 241, 232, 0.3);
  }
</style>

<script>
  const trigger = document.querySelector<HTMLElement>('[data-lightbox-trigger]');
  const lightbox = document.querySelector<HTMLElement>('[data-lightbox]');
  const closeBtn = document.querySelector<HTMLElement>('[data-lightbox-close]');

  if (trigger && lightbox && closeBtn) {
    const openLightbox = () => {
      lightbox.classList.add('active');
    };

    const closeLightbox = () => {
      lightbox.classList.remove('active');
    };

    trigger.addEventListener('click', openLightbox);
    closeBtn.addEventListener('click', closeLightbox);

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });
  }
</script>
