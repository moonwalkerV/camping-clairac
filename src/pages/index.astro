---
import Layout from '../layouts/Layout.astro';

const teasers = [
  {
    emoji: '🌿',
    title: 'Nature',
    text: "Un ancien domaine préservé, entre grands arbres et biodiversité.",
    href: '/aire-naturelle',
    ctaLabel: "Découvrir l'aire naturelle",
    image: '/images/sentier-pin-fleurs-sauvages.webp',
    alt: 'Sentier sous les pins bordé de fleurs sauvages',
    objectPosition: 'center 48%',
  },
  {
    emoji: '🏕️',
    title: 'Emplacements',
    text: "25 emplacements ombragés, spacieux, pour tente, caravane ou camping-car.",
    href: '/sejourner',
    ctaLabel: 'Voir les emplacements',
    image: '/images/tente-cloche-pins.webp',
    alt: 'Tente cloche installée sous les pins',
    objectPosition: 'center 58%',
  },
  {
    emoji: '🚲',
    title: 'Activités',
    text: "À pied, à vélo ou en famille, de quoi explorer les environs à votre rythme.",
    href: '/nos-coups-de-coeur',
    ctaLabel: 'Explorer les activités',
    image: '/images/velo-plage-dunes.webp',
    alt: 'Vélos sur la plage, entre les dunes et la mer',
    objectPosition: 'center 62%',
  },
];

const reassuranceIcons: Record<string, string> = {
  tent: '<path d="M3.5 21 14 3"/><path d="M20.5 21 10 3"/><path d="M15.5 21 12 15l-3.5 6"/><path d="M2 21h20"/>',
  paw: '<circle cx="7" cy="9" r="1.6"/><circle cx="12" cy="6.5" r="1.6"/><circle cx="17" cy="9" r="1.6"/><ellipse cx="12" cy="15.5" rx="5" ry="4"/>',
  pin: '<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>',
};

const reassurance = [
  { icon: 'tent', lines: ['25', 'Emplacements'] },
  { icon: 'paw', lines: ['Animaux', 'acceptés'] },
  { icon: 'pin', lines: ['À 15 min de Béziers', 'et des plages'] },
];

const galleryPhotos = [
  { image: '/images/vignes-domaine-batisse.webp', alt: 'Vignes du domaine avec la bâtisse ancienne' },
  { image: '/images/sanitaires-pique-nique-oliviers.webp', alt: 'Bâtiment sanitaire et espace pique-nique parmi les oliviers' },
  { image: '/images/aire-jeux-sanitaires-jour.webp', alt: 'Aire de jeux et bâtiment sanitaire en journée' },
  { image: '/images/olivier-pique-nique-sanitaires.webp', alt: 'Espace pique-nique sous un olivier près des sanitaires' },
  { image: '/images/chemin-terre-acces-chiens.webp', alt: 'Chemin de terre, accès autorisé aux chiens' },
  { image: '/images/sous-bois-tentes.webp', alt: 'Tentes installées sous les bois' },
  { image: '/images/tente-cloche-pins.webp', alt: 'Tente cloche installée sous les pins' },
  { image: '/images/accueil-bar-terrasse.webp', alt: 'Terrasse de l’accueil du camping' },
  { image: '/images/sentier-pin-fleurs-sauvages.webp', alt: 'Sentier sous les pins bordé de fleurs sauvages' },
  { image: '/images/emplacement-tente-ombrage.webp', alt: 'Emplacement de tente ombragé' },
  { image: '/images/prairie-emplacements.webp', alt: 'Prairie avec des emplacements de camping' },
  { image: '/images/chemin-pins-vignette.webp', alt: 'Chemin bordé de pins' },
  { image: '/images/aire-jeux-nuit-pleine-lune.webp', alt: 'Aire de jeux du camping au clair de lune' },
  { image: '/images/sanitaires-facade.webp', alt: 'Façade du bâtiment sanitaire' },
  { image: '/images/allee-caravanes-arbres.webp', alt: 'Allée arborée avec des caravanes' },
  { image: '/images/prairie-pins-ombragee.webp', alt: 'Prairie ombragée par les pins' },
  { image: '/images/coucher-soleil-domaine.webp', alt: 'Coucher de soleil sur le domaine' },
  { image: '/images/sanitaires-vue-laterale.webp', alt: 'Vue latérale du bâtiment sanitaire' },
  { image: '/images/camping-poules.webp', alt: 'Poules près du poulailler du domaine' },
  { image: '/images/velo-plage-dunes.webp', alt: 'Vélos sur la plage, entre les dunes et la mer' },
  { image: '/images/chemin-arbres-tunnel.webp', alt: 'Chemin ombragé sous un tunnel d’arbres' },
  { image: '/images/vegetation-fleurs-rouges.webp', alt: 'Végétation fleurie sur le domaine' },
  { image: '/images/camping-piscine-vignes.webp', alt: 'Vue sur les vignes du domaine' },
];

const galleryPreview = galleryPhotos.slice(0, 6);
---

<Layout>
  <section class="hero">
    <img
      src="/images/olivier-pique-nique-sanitaires.webp"
      alt="Olivier et espace pique-nique près du bâtiment sanitaire"
      class="hero__image"
    />
    <div class="hero__overlay"></div>
    <div class="hero__content">
      <h1>Une parenthèse nature aux portes de Béziers</h1>
      <p>25 emplacements pour tente, caravane ou camping-car, sur un ancien domaine viticole aux portes de Béziers. Ici, pas de mobil-homes ni d'animation, seulement la campagne et le temps de s'y poser.</p>
      <div class="hero__actions">
        <a href="/aire-naturelle" class="btn btn--primary">Découvrir l'aire</a>
        <a href="/infos-pratiques" class="btn btn--secondary">Préparer mon séjour</a>
      </div>
    </div>
  </section>

  <section class="reassurance">
    <div class="reassurance__grid">
      {reassurance.map((item) => (
        <div class="reassurance-card">
          <div class="reassurance-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={reassuranceIcons[item.icon]} />
          </div>
          <p class="reassurance-card__text">{item.lines[0]}<br />{item.lines[1]}</p>
        </div>
      ))}
      <div class="reassurance-card">
        <div class="reassurance-card__icon">
          <img src="/images/badge-petit-fute-2026.webp" alt="Badge Petit Futé 2026" />
        </div>
        <p class="reassurance-card__text">Recommandé par le<br />Petit Futé depuis 2004</p>
      </div>
    </div>
  </section>

  <section class="slider" id="teaser-slider">
    <div class="slider__track">
      {teasers.map((teaser, index) => (
        <div
          class="slider__slide"
          data-slide
          class:list={[{ active: index === 0 }]}
        >
          <img
            src={teaser.image}
            alt={teaser.alt}
            loading={index === 0 ? 'eager' : 'lazy'}
            style={teaser.objectPosition ? `object-position: ${teaser.objectPosition}` : undefined}
          />
          <div class="slider__overlay"></div>
          <div class="slider__dim"></div>
          <div class="slider__content">
            <h2 class="slider__title" data-slide-title>{teaser.title}</h2>
            <p class="slider__text" data-slide-text>{teaser.text}</p>
            <a href={teaser.href} class="slider__cta btn btn--primary" data-slide-cta>{teaser.ctaLabel}</a>
          </div>
        </div>
      ))}
    </div>

    <button type="button" class="slider__arrow slider__arrow--prev" data-slider-prev aria-label="Slide précédente">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <button type="button" class="slider__arrow slider__arrow--next" data-slider-next aria-label="Slide suivante">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>

    <div class="slider__dots" role="tablist" aria-label="Navigation du slider">
      {teasers.map((_, index) => (
        <button
          type="button"
          class="slider__dot"
          class:list={[{ active: index === 0 }]}
          data-slider-dot={index}
          aria-label={`Aller à la slide ${index + 1}`}
        ></button>
      ))}
    </div>
  </section>

  <section class="eco">
    <div class="eco__inner">
      <img
        src="/images/emplacement-tente-ombrage.webp"
        alt="Emplacement de tente ombragé"
        loading="lazy"
      />
      <div class="eco__text">
        <h2>Une aire naturelle, c'est quoi ?</h2>
        <p>
          Une aire naturelle de camping est un espace de séjour à taille
          humaine, où l'on privilégie la nature, la simplicité et le calme.
        </p>
        <p>
          À Clairac, vous séjournez dans un ancien domaine viticole, au cœur
          d'un environnement arboré et préservé. Les 25 emplacements
          permettent à chacun de profiter de l'espace et de la tranquillité
          du lieu, que vous voyagiez en tente, en caravane ou en camping-car.
        </p>
        <p>
          Ici, pas de grands aménagements ni de camping standardisé :
          simplement un cadre naturel pour prendre le temps de profiter de
          son séjour.
        </p>
        <p>
          Et si vous ne voyagez pas avec votre propre équipement, un gîte est
          également disponible sur le domaine.
        </p>
      </div>
    </div>
  </section>

  <section class="pricing-teaser">
    <div class="pricing-teaser__inner">
      <h2>Tarifs 2026</h2>
      <p>Des tarifs simples et transparents pour tous les types d'emplacements.</p>
      <a href="/sejourner/tarifs" class="btn btn--primary">Voir tous les tarifs</a>
    </div>
  </section>

  <section class="gallery-preview" data-gallery-preview data-gallery-photos={JSON.stringify(galleryPhotos)}>
    <h2>Galerie</h2>
    <div class="gallery-preview__grid">
      {galleryPreview.map((photo) => (
        <img src={photo.image} alt={photo.alt} loading="lazy" data-gallery-photo />
      ))}
    </div>
    <a href="/galerie" class="btn btn--secondary">Voir toute la galerie</a>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--color-cream);
    overflow: hidden;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(36, 56, 44, 0.35), rgba(36, 56, 44, 0.65));
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 700px;
    padding: 0 1.5rem;
  }

  .hero__content h1 {
    color: var(--color-cream);
    font-size: clamp(2rem, 5vw, 3.25rem);
    margin-bottom: 1rem;
  }

  .hero__content p {
    font-size: 1.15rem;
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    font-weight: 600;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .btn--primary {
    background-color: var(--color-forest);
    color: var(--color-cream);
  }

  .btn--primary:hover {
    background-color: var(--color-sage);
  }

  .btn--secondary {
    background-color: var(--color-cream);
    color: var(--color-forest);
    border: 1px solid var(--color-forest);
  }

  .btn--secondary:hover {
    background-color: var(--color-sand);
  }

  .reassurance {
    background-color: var(--color-sand);
    padding: 3rem 1.5rem;
  }

  .reassurance__grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .reassurance-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.75rem;
    background-color: #fff;
    border: 1px solid var(--color-sand);
    border-radius: 16px;
    padding: 2rem 1.5rem;
    box-shadow: 0 4px 16px rgba(36, 56, 44, 0.06);
  }

  .reassurance-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background-color: rgba(104, 122, 90, 0.15);
    color: var(--color-forest);
    overflow: hidden;
  }

  .reassurance-card__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 0.75rem;
    box-sizing: border-box;
  }

  .reassurance-card__text {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-forest);
    max-width: 190px;
  }

  .slider {
    position: relative;
    width: 100%;
    height: 480px;
    overflow: hidden;
  }

  .slider__track {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .slider__slide {
    position: absolute;
    inset: 0;
    display: block;
    transform: translateX(calc(var(--offset, 0) * 100%));
    transition: transform 0.8s cubic-bezier(0.65, 0, 0.35, 1);
    pointer-events: none;
  }

  .slider__slide.active {
    pointer-events: auto;
  }

  .slider__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slider__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0));
  }

  .slider__dim {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.2);
  }

  .slider__content {
    position: absolute;
    inset: 0;
    padding: 2.5rem 4rem;
    color: var(--color-cream);
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .slider__title {
    font-family: 'Bryndan Write', cursive;
    text-transform: uppercase;
    color: var(--color-cream);
    font-size: clamp(2.4rem, 6vw, 3.5rem);
    line-height: 1.1;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
    margin-bottom: 0.75rem;
    opacity: 0;
    transform: translateY(20px);
  }

  .slider__text {
    max-width: 550px;
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    opacity: 0;
    transform: translateY(20px);
  }

  .slider__cta {
    margin-top: 1.5rem;
    opacity: 0;
    transform: translateY(20px);
  }

  .slider__title.slide-in {
    animation: slide-in-up 0.9s ease 0.4s forwards;
  }

  .slider__text.slide-in {
    animation: slide-in-up 0.9s ease 0.5s forwards;
  }

  .slider__cta.slide-in {
    animation: slide-in-up 0.9s ease 0.6s forwards;
  }

  @keyframes slide-in-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .slider__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: rgba(36, 56, 44, 0.45);
    color: var(--color-cream);
    transition: background-color 0.2s ease;
  }

  .slider__arrow:hover {
    background-color: rgba(36, 56, 44, 0.7);
  }

  .slider__arrow--prev {
    left: 1.5rem;
  }

  .slider__arrow--next {
    right: 1.5rem;
  }

  .slider__dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.25rem;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
  }

  .slider__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: rgba(244, 241, 232, 0.6);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .slider__dot.active {
    background-color: var(--color-cream);
    transform: scale(1.4);
  }

  .eco {
    background-color: var(--color-sand);
    padding: 4rem 1.5rem;
  }

  .eco__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .eco__inner img {
    width: 100%;
    height: 320px;
    object-fit: cover;
    object-position: center 70%;
    border-radius: 12px;
  }

  .eco__text h2 {
    margin-bottom: 1rem;
  }

  .pricing-teaser {
    padding: 4rem 1.5rem;
    text-align: center;
  }

  .pricing-teaser__inner {
    max-width: 600px;
    margin: 0 auto;
  }

  .pricing-teaser__inner h2 {
    margin-bottom: 0.75rem;
  }

  .pricing-teaser__inner p {
    margin-bottom: 1.5rem;
  }

  .gallery-preview {
    padding: 4rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .gallery-preview h2 {
    margin-bottom: 1.5rem;
  }

  .gallery-preview__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .gallery-preview__grid img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 12px;
  }

  .gallery-preview__grid img.is-changing {
    animation: gallery-photo-change 0.55s ease both;
  }

  @keyframes gallery-photo-change {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-preview__grid img.is-changing {
      animation: none;
    }
  }

  @media (max-width: 860px) {
    .reassurance__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .slider {
      height: 380px;
    }

    .slider__arrow {
      width: 32px;
      height: 32px;
    }

    .slider__arrow--prev {
      left: 0.6rem;
    }

    .slider__arrow--next {
      right: 0.6rem;
    }

    .slider__content {
      padding: 1.5rem 2.75rem;
    }

    .slider__title {
      font-size: 2rem;
    }

    .slider__text {
      font-size: 0.95rem;
    }

    .eco__inner {
      grid-template-columns: 1fr;
    }

    .gallery-preview__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .gallery-preview__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .reassurance__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const slider = document.getElementById('teaser-slider');

  if (slider) {
    const slides = Array.from(slider.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(slider.querySelectorAll<HTMLElement>('[data-slider-dot]'));
    const prevBtn = slider.querySelector<HTMLElement>('[data-slider-prev]');
    const nextBtn = slider.querySelector<HTMLElement>('[data-slider-next]');
    let activeIndex = slides.findIndex((slide) => slide.classList.contains('active'));
    if (activeIndex === -1) activeIndex = 0;

    const playEntranceAnimation = (slide: HTMLElement) => {
      const title = slide.querySelector<HTMLElement>('[data-slide-title]');
      const text = slide.querySelector<HTMLElement>('[data-slide-text]');
      const cta = slide.querySelector<HTMLElement>('[data-slide-cta]');

      [title, text, cta].forEach((el) => {
        if (!el) return;
        el.classList.remove('slide-in');
        void el.offsetWidth;
        el.classList.add('slide-in');
      });
    };

    const updatePositions = () => {
      slides.forEach((slide, i) => {
        slide.style.setProperty('--offset', String(i - activeIndex));
      });
    };

    const goToSlide = (index: number) => {
      const total = slides.length;
      activeIndex = (index + total) % total;

      slides.forEach((slide, i) => {
        slide.classList.toggle('active', i === activeIndex);
      });

      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === activeIndex);
      });

      updatePositions();
      playEntranceAnimation(slides[activeIndex]);
    };

    updatePositions();
    playEntranceAnimation(slides[activeIndex]);

    prevBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      goToSlide(activeIndex - 1);
    });

    nextBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      goToSlide(activeIndex + 1);
    });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', (e) => {
        e.preventDefault();
        goToSlide(i);
      });
    });

    slider.addEventListener('keydown', (e) => {
      const event = e as KeyboardEvent;
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goToSlide(activeIndex - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        goToSlide(activeIndex + 1);
      }
    });

    slider.setAttribute('tabindex', '0');
  }

  const gallery = document.querySelector<HTMLElement>('[data-gallery-preview]');

  if (gallery) {
    const photoElements = Array.from(gallery.querySelectorAll<HTMLImageElement>('[data-gallery-photo]'));
    const photoPool = JSON.parse(gallery.dataset.galleryPhotos ?? '[]') as Array<{ image: string; alt: string }>;
    let previousSelection = '';

    const shufflePhotos = () => {
      const photos = [...photoPool];

      for (let index = photos.length - 1; index > 0; index -= 1) {
        const randomIndex = Math.floor(Math.random() * (index + 1));
        [photos[index], photos[randomIndex]] = [photos[randomIndex], photos[index]];
      }

      return photos.slice(0, photoElements.length);
    };

    const refreshGallery = () => {
      let selection = shufflePhotos();
      let selectionKey = selection.map((photo) => photo.image).join('|');

      if (selectionKey === previousSelection && selection.length > 1) {
        selection = [...selection.slice(1), selection[0]];
        selectionKey = selection.map((photo) => photo.image).join('|');
      }

      previousSelection = selectionKey;

      photoElements.forEach((element, index) => {
        const photo = selection[index];
        if (!photo) return;

        element.classList.remove('is-changing');
        void element.offsetWidth;
        element.src = photo.image;
        element.alt = photo.alt;
        element.style.animationDelay = `${index * 70}ms`;
        element.classList.add('is-changing');
      });
    };

    const galleryObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) refreshGallery();
        });
      },
      { threshold: 0.35 },
    );

    galleryObserver.observe(gallery);
  }
</script>
