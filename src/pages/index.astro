---
import Layout from '../layouts/Layout.astro';

const teasers = [
  {
    emoji: '🌿',
    title: 'Nature',
    text: "Un ancien domaine préservé, entre grands arbres et biodiversité.",
    href: '/aire-naturelle',
    image: '/images/vignes-domaine-batisse.webp',
    alt: 'Vignes du domaine avec la bâtisse ancienne',
  },
  {
    emoji: '🏕️',
    title: 'Emplacements',
    text: "25 emplacements ombragés, spacieux, pour tente, caravane ou camping-car.",
    href: '/sejourner',
    image: '/images/allee-caravanes-arbres.webp',
    alt: 'Allée bordée d\'arbres avec des caravanes',
  },
  {
    emoji: '🚲',
    title: 'Activités',
    text: "À pied, à vélo ou en famille, de quoi explorer les environs à votre rythme.",
    href: '/decouvrir',
    image: '/images/chemin-arbres-tunnel.webp',
    alt: 'Chemin ombragé sous un tunnel d\'arbres',
  },
];

const reassurance = [
  { emoji: '🏕️', text: '25 emplacements' },
  { emoji: '🐾', text: 'Animaux acceptés' },
  { emoji: '📍', text: 'À 15 min de Béziers et des plages' },
];

const petitFuteBadges = [
  { image: '/images/badge-petit-fute-2024.webp', alt: 'Badge Petit Futé 2024' },
  { image: '/images/badge-petit-fute-2025.webp', alt: 'Badge Petit Futé 2025' },
  { image: '/images/badge-petit-fute-2026.webp', alt: 'Badge Petit Futé 2026' },
];

const galleryPreview = [
  { image: '/images/sanitaires-facade.webp', alt: 'Façade des sanitaires du camping' },
  { image: '/images/accueil-bar-terrasse.webp', alt: 'Terrasse du bar d\'accueil' },
  { image: '/images/emplacement-tente-ombrage.webp', alt: 'Emplacement de tente ombragé' },
  { image: '/images/chemin-arbres-tunnel.webp', alt: 'Chemin en tunnel sous les arbres' },
  { image: '/images/sous-bois-tentes.webp', alt: 'Tentes installées sous les bois' },
  { image: '/images/prairie-emplacements.webp', alt: 'Prairie avec emplacements de camping' },
];
---

<Layout>
  <section class="hero">
    <img
      src="/images/vegetation-fleurs-rouges.webp"
      alt="Végétation fleurie aux couleurs rouges sur le domaine"
      class="hero__image"
    />
    <div class="hero__overlay"></div>
    <div class="hero__content">
      <h1>Une parenthèse nature aux portes de Béziers</h1>
      <p>25 emplacements pour tente, caravane ou camping-car, sur un ancien domaine viticole aux portes de Béziers. Ici, pas de mobil-homes ni d'animation, seulement la campagne et le temps de s'y poser.</p>
      <div class="hero__actions">
        <a href="/aire-naturelle" class="btn btn--primary">Découvrir l'aire</a>
        <a href="/infos-pratiques" class="btn btn--secondary">Préparer mon séjour</a>
      </div>
    </div>
  </section>

  <section class="reassurance">
    <div class="reassurance__grid">
      {reassurance.map((item) => (
        <div class="reassurance-card">
          <div class="reassurance-card__icon" aria-hidden="true">{item.emoji}</div>
          <p class="reassurance-card__text">{item.text}</p>
        </div>
      ))}
      <div class="reassurance-card reassurance-card--petit-fute">
        <p class="reassurance-card__text">Recommandé par le Petit Futé depuis 2004</p>
        <div class="reassurance-card__badges">
          {petitFuteBadges.map((badge) => (
            <img src={badge.image} alt={badge.alt} loading="lazy" />
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="teasers">
    <div class="teasers__grid">
      {teasers.map((teaser) => (
        <a href={teaser.href} class="teaser-card">
          <img src={teaser.image} alt={teaser.alt} loading="lazy" />
          <div class="teaser-card__body">
            <h2>{teaser.emoji} {teaser.title}</h2>
            <p>{teaser.text}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="eco">
    <div class="eco__inner">
      <img
        src="/images/sous-bois-tentes.webp"
        alt="Tentes installées sous les bois dans une ambiance calme"
        loading="lazy"
      />
      <div class="eco__text">
        <h2>Une aire naturelle, c'est quoi ?</h2>
        <p>
          Une aire naturelle de camping est un espace de séjour à taille
          humaine, où l'on privilégie la nature, la simplicité et le calme.
        </p>
        <p>
          À Clairac, vous séjournez dans un ancien domaine viticole, au cœur
          d'un environnement arboré et préservé. Les 25 emplacements
          permettent à chacun de profiter de l'espace et de la tranquillité
          du lieu, que vous voyagiez en tente, en caravane ou en camping-car.
        </p>
        <p>
          Ici, pas de grands aménagements ni de camping standardisé :
          simplement un cadre naturel pour prendre le temps de profiter de
          son séjour.
        </p>
        <p>
          Et si vous ne voyagez pas avec votre propre équipement, un gîte est
          également disponible sur le domaine.
        </p>
      </div>
    </div>
  </section>

  <section class="pricing-teaser">
    <div class="pricing-teaser__inner">
      <h2>Tarifs 2026</h2>
      <p>Des tarifs simples et transparents pour tous les types d'emplacements.</p>
      <a href="/sejourner/tarifs" class="btn btn--primary">Voir tous les tarifs</a>
    </div>
  </section>

  <section class="gallery-preview">
    <h2>Galerie</h2>
    <div class="gallery-preview__grid">
      {galleryPreview.map((photo) => (
        <img src={photo.image} alt={photo.alt} loading="lazy" />
      ))}
    </div>
    <a href="/galerie" class="btn btn--secondary">Voir toute la galerie</a>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--color-cream);
    overflow: hidden;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(36, 56, 44, 0.35), rgba(36, 56, 44, 0.65));
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 700px;
    padding: 0 1.5rem;
  }

  .hero__content h1 {
    color: var(--color-cream);
    font-size: clamp(2rem, 5vw, 3.25rem);
    margin-bottom: 1rem;
  }

  .hero__content p {
    font-size: 1.15rem;
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    font-weight: 600;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .btn--primary {
    background-color: var(--color-forest);
    color: var(--color-cream);
  }

  .btn--primary:hover {
    background-color: var(--color-sage);
  }

  .btn--secondary {
    background-color: var(--color-cream);
    color: var(--color-forest);
    border: 1px solid var(--color-forest);
  }

  .btn--secondary:hover {
    background-color: var(--color-sand);
  }

  .reassurance {
    background-color: var(--color-sand);
    padding: 3rem 1.5rem;
  }

  .reassurance__grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .reassurance-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.75rem;
    background-color: #fff;
    border: 1px solid var(--color-sand);
    border-radius: 16px;
    padding: 2rem 1.5rem;
    box-shadow: 0 4px 16px rgba(36, 56, 44, 0.06);
  }

  .reassurance-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background-color: rgba(104, 122, 90, 0.15);
    font-size: 2.5rem;
    line-height: 1;
  }

  .reassurance-card__text {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-forest);
  }

  .reassurance-card--petit-fute {
    background-color: var(--color-cream);
  }

  .reassurance-card__badges {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .reassurance-card__badges img {
    height: 50px;
    width: auto;
  }

  .teasers {
    padding: 4rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .teasers__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .teaser-card {
    display: block;
    background-color: var(--color-cream);
    border: 1px solid var(--color-sand);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .teaser-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(36, 56, 44, 0.12);
  }

  .teaser-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .teaser-card__body {
    padding: 1.25rem;
  }

  .teaser-card__body h2 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .eco {
    background-color: var(--color-sand);
    padding: 4rem 1.5rem;
  }

  .eco__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .eco__inner img {
    width: 100%;
    height: 320px;
    object-fit: cover;
    border-radius: 12px;
  }

  .eco__text h2 {
    margin-bottom: 1rem;
  }

  .pricing-teaser {
    padding: 4rem 1.5rem;
    text-align: center;
  }

  .pricing-teaser__inner {
    max-width: 600px;
    margin: 0 auto;
  }

  .pricing-teaser__inner h2 {
    margin-bottom: 0.75rem;
  }

  .pricing-teaser__inner p {
    margin-bottom: 1.5rem;
  }

  .gallery-preview {
    padding: 4rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .gallery-preview h2 {
    margin-bottom: 1.5rem;
  }

  .gallery-preview__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .gallery-preview__grid img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 12px;
  }

  @media (max-width: 860px) {
    .reassurance__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .teasers__grid {
      grid-template-columns: 1fr;
    }

    .eco__inner {
      grid-template-columns: 1fr;
    }

    .gallery-preview__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .gallery-preview__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
