---
import Layout from '../../layouts/Layout.astro';

const equipements = [
  { emoji: '🚿', label: 'Sanitaires' },
  { emoji: '📶', label: 'Wi-Fi' },
  { emoji: '🥖', label: 'Dépôt de pain' },
  { emoji: '🔥', label: 'Barbecue' },
  { emoji: '🛝', label: 'Aire de jeux' },
  { emoji: '🐾', label: 'Animaux acceptés' },
];
---

<Layout title="Séjourner — Camping Clairac">
  <section id="emplacements" class="section">
    <div class="section__inner">
      <div class="section__gallery">
        <img
          src="/images/allee-caravanes-arbres.webp"
          alt="Allée arborée avec des caravanes"
          loading="lazy"
        />
        <img
          src="/images/camping-emplacements-oliviers.webp"
          alt="Emplacements ombragés parmi les oliviers"
          loading="lazy"
        />
      </div>
      <div class="section__text">
        <h1>Les emplacements</h1>
        <p>
          25 emplacements pour tente, caravane ou camping-car, répartis dans
          un cadre calme et ombragé. Chaque emplacement est spacieux et
          espacé d'au moins 5 mètres de son voisin, pour profiter pleinement
          du plein air sans être les uns sur les autres.
        </p>
      </div>
    </div>
  </section>

  <section id="gite" class="section">
    <div class="section__inner">
      <div class="section__gallery section__gallery--quad">
        <img
          src="/images/gite-exterieur-terrasse.webp"
          alt="Terrasse extérieure du gîte"
          loading="lazy"
        />
        <img
          src="/images/gite-jardin-transats.webp"
          alt="Jardin ombragé du gîte avec transats"
          loading="lazy"
        />
        <img
          src="/images/gite-interieur-cuisine.webp"
          alt="Cuisine équipée du gîte"
          loading="lazy"
        />
        <img
          src="/images/gite-interieur-couloir-sdb.webp"
          alt="Salle de bain privative du gîte"
          loading="lazy"
        />
      </div>
      <div class="section__text">
        <h2>Le gîte</h2>
        <p>
          Pas d'équipement à vous ? On a aussi une maison indépendante sur le
          domaine, pour ceux qui préfèrent poser leurs valises sans tente ni
          camping-car. On y trouve une cuisine équipée, une salle à manger et
          une salle de bain privative, tout le confort d'une vraie maison.
        </p>
        <p>
          Dehors, un jardin ombragé avec des transats invite à ne rien faire,
          dans le même calme que le reste du domaine.
        </p>
        <a href="/infos-pratiques/contact" class="btn btn--primary">Nous contacter pour réserver</a>
      </div>
    </div>
  </section>

  <section id="equipements" class="section section--alt">
    <div class="section__inner section__inner--reverse">
      <div class="section__gallery section__gallery--quad">
        <img
          src="/images/camping-sanitaires-wc.webp"
          alt="Sanitaires : bloc WC"
          loading="lazy"
        />
        <img
          src="/images/camping-sanitaires-douche.webp"
          alt="Sanitaires : douche"
          loading="lazy"
        />
        <img
          src="/images/camping-sanitaires-lavabos.webp"
          alt="Sanitaires : lavabos"
          loading="lazy"
        />
        <img
          src="/images/camping-sanitaires-pmr.webp"
          alt="Sanitaires accessibles PMR"
          loading="lazy"
        />
      </div>
      <div class="section__text">
        <h2>Équipements & services</h2>
        <ul class="equipements-grid">
          {equipements.map((item) => (
            <li>
              <span class="equipements-grid__emoji" aria-hidden="true">{item.emoji}</span>
              {item.label}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="tarifs" class="section pricing">
    <div class="pricing__inner">
      <h2>Tarifs</h2>
      <p>Des tarifs simples et transparents pour tous les types d'emplacements.</p>
      <a href="/sejourner/tarifs" class="btn btn--primary">Voir le détail des tarifs</a>
    </div>
  </section>
</Layout>

<style>
  .section {
    padding: 4rem 1.5rem;
  }

  .section--alt {
    background-color: var(--color-sand);
  }

  .section__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .section__inner--reverse {
    direction: rtl;
  }

  .section__inner--reverse > * {
    direction: ltr;
  }

  .section__inner img {
    width: 100%;
    height: 320px;
    object-fit: cover;
    border-radius: 12px;
  }

  .section__gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  .section__gallery img {
    height: 320px;
  }

  .section__gallery--quad {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, 1fr);
  }

  .section__gallery--quad img {
    height: 155px;
  }

  .section__text h1,
  .section__text h2 {
    margin-bottom: 1rem;
  }

  .equipements-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .equipements-grid li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 500;
  }

  .equipements-grid__emoji {
    font-size: 1.4rem;
  }

  .pricing {
    text-align: center;
  }

  .pricing__inner {
    max-width: 600px;
    margin: 0 auto;
  }

  .pricing__inner h2 {
    margin-bottom: 0.75rem;
  }

  .pricing__inner p {
    margin-bottom: 1.5rem;
  }

  .btn {
    display: inline-block;
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    font-weight: 600;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .btn--primary {
    background-color: var(--color-forest);
    color: var(--color-cream);
  }

  .btn--primary:hover {
    background-color: var(--color-sage);
  }

  @media (max-width: 860px) {
    .section__inner,
    .section__inner--reverse {
      grid-template-columns: 1fr;
      direction: ltr;
    }

    .equipements-grid {
      grid-template-columns: 1fr;
    }

    .section__gallery img {
      height: 220px;
    }

    .section__gallery--quad img {
      height: 160px;
    }
  }
</style>
