---
import Layout from '../../layouts/Layout.astro';

const emplacement = [
  { label: 'Emplacement pour caravane / tente / voiture (2 personnes incluses)', value: '25,00 €' },
  { label: 'Adulte supplémentaire', value: '6,00 €' },
  { label: 'Enfant (- de 13 ans)', value: '4,00 €' },
  { label: 'Électricité', value: '5,00 €' },
  { label: 'Animaux domestiques (chien, chat, etc.)', value: '2,00 €' },
];

const supplements = [
  { label: 'Petite tente supplémentaire', value: '5,00 €' },
  { label: 'Caravane de plus de 6 m', value: '5,00 €' },
  { label: 'Deuxième voiture', value: '5,00 €' },
  { label: 'Fourgon aménagé (utilisé comme camping-car)', value: '5,00 €' },
];

const services = [
  { label: 'Douche chaude', value: 'Gratuit' },
  { label: 'Machine à laver (par lavage)', value: '5,00 €' },
  { label: 'Dose de lessive', value: '1,50 €' },
  { label: 'Adaptateur électrique (caution)', value: '30,00 €' },
  { label: 'Location de câble électrique', value: '1,00 €' },
  { label: 'Câble électrique (caution)', value: '30,00 €' },
];

const taxeSejour = [
  { label: 'Taxe de séjour par personne (à partir de 18 ans)', value: '0,29 €' },
];

const tarifTables = [
  { title: 'Emplacement / jour', rows: emplacement },
  { title: 'Suppléments', rows: supplements },
  { title: 'Services', rows: services },
  { title: 'Taxe de séjour', rows: taxeSejour },
];

const inclus = [
  'Emplacement',
  'Accès aux sanitaires',
  'Accès à l\'aire de jeux',
  'Wi-Fi',
];
---

<Layout title="Tarifs 2026 — Camping Clairac">
  <section class="pricing-page">
    <div class="pricing-page__inner">
      <h1>Tarifs 2026</h1>

      {tarifTables.map((table) => (
        <div class="pricing-table-wrapper">
          <h2>{table.title}</h2>
          <table class="pricing-table">
            <thead>
              <tr>
                <th>Désignation</th>
                <th>Prix</th>
              </tr>
            </thead>
            <tbody>
              {table.rows.map((tarif) => (
                <tr>
                  <td>{tarif.label}</td>
                  <td>{tarif.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}

      <div class="included">
        <h2>Ce qui est inclus</h2>
        <ul>
          {inclus.map((item) => (
            <li>✓ {item}</li>
          ))}
        </ul>
      </div>

      <a href="/infos-pratiques" class="btn btn--primary">Nous contacter pour réserver</a>
    </div>
  </section>
</Layout>

<style>
  .pricing-page {
    padding: 4rem 1.5rem;
  }

  .pricing-page__inner {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .pricing-page__inner h1 {
    margin-bottom: 2rem;
  }

  .pricing-table-wrapper {
    text-align: left;
    margin-bottom: 2.5rem;
  }

  .pricing-table-wrapper h2 {
    margin-bottom: 0.75rem;
  }

  .pricing-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    overflow: hidden;
    border-radius: 8px;
  }

  .pricing-table th {
    background-color: var(--color-sage);
    color: var(--color-cream);
    padding: 0.75rem 0.85rem;
    font-weight: 600;
  }

  .pricing-table th:last-child {
    text-align: right;
  }

  .pricing-table tr {
    border-bottom: 1px solid var(--color-sand);
  }

  .pricing-table td {
    padding: 0.85rem 0.85rem;
  }

  .pricing-table td:last-child {
    text-align: right;
    font-weight: 600;
  }

  .included {
    text-align: left;
    background-color: var(--color-cream);
    border: 1px solid var(--color-sand);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .included h2 {
    margin-bottom: 1rem;
  }

  .included ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .btn {
    display: inline-block;
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    font-weight: 600;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .btn--primary {
    background-color: var(--color-forest);
    color: var(--color-cream);
  }

  .btn--primary:hover {
    background-color: var(--color-sage);
  }
</style>
