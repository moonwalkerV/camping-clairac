---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Tarifs du gîte — Camping Clairac">
  <section class="pricing-page">
    <div class="pricing-page__inner">
      <h1>Tarifs du gîte</h1>
      <p>Grille tarifaire à venir prochainement.</p>
    </div>
  </section>
</Layout>

<style>
  .pricing-page {
    padding: 4rem 1.5rem;
  }

  .pricing-page__inner {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }

  .pricing-page__inner h1 {
    margin-bottom: 1rem;
  }
</style>
