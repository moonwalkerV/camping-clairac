{% for s in accueil.sections %}
  {% if loop.first %}{% set s = hero %}{% include "sections/hero-terre.njk" %}{% else %}{% include "sections/" + s.type + ".njk" %}{% endif %}
{% endfor %}
<script>
(function(){
  var h=document.querySelector(".entete"),hero=document.querySelector(".th");
  function s(){h.classList.toggle("solide",scrollY>hero.offsetHeight-140)}
  addEventListener("scroll",s,{passive:true});s();
  var rm=matchMedia("(prefers-reduced-motion: reduce)").matches;
  if(rm||!("IntersectionObserver"in window))return;
  var mots=document.querySelectorAll(".amb-phrase .mot");
  mots.forEach(function(m,i){m.style.setProperty("--i",i)});
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add("vu");io.unobserve(e.target)}})},{threshold:.15});
  document.querySelectorAll(".amb-phrase,.amb-p,.section h2,.sejour,.lieu").forEach(function(e){if(e.getBoundingClientRect().top>innerHeight*.9){e.classList.add("avant");io.observe(e)}});
})();
</script>
